---
import { gallery } from '../data/site';
---

<section class="px-[5vw] py-[14vh]">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-[clamp(2.5rem,8vw,7rem)] leading-none font-bold tracking-[-0.04em]">
      Through the <em class="font-serif font-normal">lens</em>
    </h2>
    <a href="#" class="rounded-full px-5 py-2.5 font-medium ring-1 ring-ink transition hover:bg-ink hover:text-paper">
      More on Instagram →
    </a>
  </div>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
    {
      gallery.map((g, i) => (
        <div
          class:list={[
            'group relative aspect-square overflow-hidden rounded-2xl bg-linear-135',
            g,
            i === 0 && 'col-span-2 sm:row-span-2 sm:aspect-auto',
          ]}
        >
          <span class="absolute inset-0 flex items-center justify-center bg-ink/0 text-sm font-medium text-paper opacity-0 transition group-hover:bg-ink/40 group-hover:opacity-100">
            Photo {i + 1}
          </span>
        </div>
      ))
    }
  </div>
</section>
