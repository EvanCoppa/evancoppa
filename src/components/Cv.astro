---
import Cta from './Cta.astro';
import Portrait from './Portrait.astro';
import { breaks, resume, site } from '../data/site';

const pill = 'rounded-full border border-current px-1.5 text-[5px] leading-[9px] font-medium tracking-[0.5px] uppercase md:px-2 md:text-[8px] md:leading-[14px]';
---

<section data-cv class="relative mx-auto flex h-[300vh] w-full max-w-[1800px] flex-col items-center perspective-[1500px]">
  <!-- Tri-fold sheet: unfolds, scrolls, then dims and shrinks under the download prompt -->
  <div data-cv-box class="sticky top-0 flex w-[90%] max-w-[800px] flex-col backface-hidden perspective-[1000px] md:w-[800px]">
    <div class="relative flex w-full origin-bottom flex-col items-center backface-hidden perspective-[2000px]">
      <div class="sheet aspect-[800/377] w-full px-[5%] pt-[3%]">
        <div class="flex justify-between text-[6px] font-bold tracking-[1px] uppercase md:text-[9px]">
          <span>Resume © {site.year}</span><span>{resume.contact[1]}</span>
        </div>
        <div class="relative mt-[3%] flex flex-col items-center">
          <div class="absolute top-[-6%] h-[115%] w-[13%] overflow-hidden opacity-90 grayscale"><Portrait /></div>
          {[resume.name, resume.role, `Portfolio ${site.year}`].map((l) => <p class="font-display relative text-center text-[6.5vw] leading-[0.95] font-medium md:text-[58px]">{l}</p>)}
          <p class="relative mt-[2%] text-center text-[6px] leading-tight md:text-[9px]">{resume.contact[0]}</p>
        </div>
      </div>
    </div>
    <div class="relative flex w-full origin-top flex-col items-center backface-hidden perspective-[2000px]">
      <div data-fold-mid class="relative flex w-full origin-top flex-col items-center justify-start backface-hidden">
        <div class="sheet sheet-fold grid aspect-[800/377] w-full grid-cols-2 gap-[5%] px-[5%] pt-[3%]">
          <div>
            <p class="mb-[3%] text-[5px] tracking-[1px] uppercase opacity-70 md:text-[8px]">Experience</p>
            {resume.experience.map((x) => (
              <div class="mb-[4%]">
                <p class="font-display text-[12px] leading-none font-medium md:text-[22px]">{x.title}</p>
                <div class="my-[2%] flex flex-wrap gap-1">{x.meta.map((m) => <span class={pill}>{m}</span>)}</div>
                <p class="text-[5px] leading-snug md:text-[9px]">{x.text}</p>
              </div>
            ))}
          </div>
          <div>
            <p class="mb-[3%] text-[5px] tracking-[1px] uppercase opacity-70 md:text-[8px]">Education</p>
            {resume.education.map((x) => (
              <div class="mb-[4%]">
                <p class="font-display text-[12px] leading-none font-medium md:text-[22px]">{x.title}</p>
                <div class="my-[2%] flex flex-wrap gap-1">{x.meta.map((m) => <span class={pill}>{m}</span>)}</div>
                <p class="text-[5px] leading-snug md:text-[9px]">{x.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div data-fold-bottom class="relative -top-px flex w-full origin-top flex-col items-center backface-hidden">
        <div class="sheet sheet-fold flex aspect-[800/377] w-full flex-col px-[5%] pt-[3%]">
          <p class="mb-[2%] text-[5px] tracking-[1px] uppercase opacity-70 md:text-[8px]">Toolbox</p>
          <div class="flex flex-wrap gap-1">{resume.skills.map((s) => <span class={pill}>{s}</span>)}</div>
          <p class="mx-auto mt-[6%] w-3/5 text-center text-[6px] leading-snug md:text-[10px]">{resume.summary}</p>
          <svg viewBox="0 0 120 40" class="mx-auto mt-[3%] w-[12%] fill-none stroke-current stroke-[1.5]" aria-hidden="true"><path d="M5 28c10-18 18-22 20-12s-6 16 2 10 12-20 16-14-4 16 4 12 10-10 14-6 4 8 12 2 14-8 22-4" /></svg>
          <div class="mt-auto mb-[4%] flex justify-between text-[6px] font-bold tracking-[1px] uppercase md:text-[9px]">
            <span>GitHub / EvanCoppa</span><span>LinkedIn / EvanCoppa</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-[125vh] w-full">
    <div class="sticky top-0 flex h-screen w-full flex-col items-center justify-center">
      <h2 class="font-display relative text-center text-[16vw] leading-[0.9] text-mist sm:text-[14vw] lg:text-[6vw]">
        {breaks.resume.title[0]}<br />{breaks.resume.title[1]}
      </h2>
      <Cta href={site.resumeUrl}>{breaks.resume.cta}</Cta>
    </div>
  </div>
</section>

<style>
  .sheet {
    color: #3c6ef0;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.6), transparent 70%),
      linear-gradient(180deg, #e9ecf4, #dfe3ee);
  }
  /* soft crease shading at the top of each folded panel */
  .sheet-fold {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.08), transparent 12%),
      radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.5), transparent 70%),
      linear-gradient(180deg, #e7eaf2, #dde1ec);
  }
</style>

<script>
  import { scrollTimeline, type Track } from '../scripts/ix';

  const cv = document.querySelector<HTMLElement>('[data-cv]')!;
  const folds: Track[] = [
    ['[data-fold-mid]', 'rx', [[0, -120], [15, -120], [25, 0]]],
    ['[data-fold-bottom]', 'rx', [[0, -90], [15, -90], [25, -179], [35, -100], [45, 0]]],
    ['[data-cv-box]', 'gray', [[55, 0], [65, 100]]],
    ['[data-cv-box]', 'bright', [[55, 100], [65, 25]]],
    ['[data-cv-box]', 's', [[70, 1], [75, 0.5]]],
  ];
  // Desktop: the sheet also travels up so every panel passes through view.
  scrollTimeline(cv, { startsEntering: true, smoothing: 80, media: '(min-width: 768px)' }, [
    ...folds,
    ['[data-cv-box]', 'y', [[15, 0], [25, -200], [35, -200], [55, -500], [65, 0], [75, 125]]],
  ]);
  // Mobile: the sheet stays put while it unfolds, then drops as it shrinks.
  scrollTimeline(cv, { startsEntering: true, smoothing: 86, media: '(max-width: 767px)' }, [
    ...folds,
    ['[data-cv-box]', 'y', [[70, 0], [75, 33], [80, -75]]],
  ]);
</script>
