---
import { site } from '../data/site';

const pages = [1, 2, 3];
---

<section class="bg-stone px-[5vw] py-[14vh]">
  <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.4fr]">
    <div class="flex flex-col items-start gap-6">
      <h2 class="text-[clamp(2.5rem,8vw,7rem)] leading-none font-bold tracking-[-0.04em]">Résumé</h2>
      <p class="max-w-md text-xl">A short overview of my experience, skills and education.</p>
      <a
        href={site.cvUrl}
        class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 font-medium text-paper transition-all hover:gap-5 hover:bg-accent"
      >
        Download CV <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="flex justify-center">
      {
        pages.map((p, i) => (
          <div
            class:list={[
              'aspect-[1/1.414] w-1/3 max-w-56 rounded-md bg-paper p-[6%] shadow-xl transition duration-500 hover:z-10 hover:-translate-y-3',
              i === 0 && '-rotate-6',
              i === 1 && 'z-[1] -mx-6 -translate-y-4',
              i === 2 && 'rotate-6',
            ]}
          >
            <div class="mb-3 h-2.5 w-2/3 rounded bg-ink" />
            {Array.from({ length: 9 }, (_, j) => (
              <div class:list={['mb-2 h-1.5 rounded bg-neutral-200', j % 3 === 2 ? 'w-3/5' : 'w-full']} />
            ))}
            <p class="mt-4 text-right text-[10px] text-neutral-400">{p} / {pages.length}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
