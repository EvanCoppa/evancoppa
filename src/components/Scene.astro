---
import type { Scene } from '../data/site';
import { scenes } from '../data/scenes';

interface Props {
  scene: Scene;
  class?: string;
  image?: string;
  alt?: string;
  [attr: `data-${string}`]: string;
}

const { scene, class: className = '', image, alt = '', ...rest } = Astro.props;
---

{
  image ? (
    <img src={image} alt={alt} class:list={['object-cover', className]} loading="lazy" {...rest} />
  ) : (
    <div role="img" aria-label={alt || `${scene} placeholder`} class={className} style={`background:${scenes[scene]};background-size:cover`} {...rest} />
  )
}
