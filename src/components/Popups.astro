---
// A tongue-in-cheek section: the web's most annoying UI patterns, stacked up.
---

<section class="relative overflow-hidden bg-paper px-[5vw] py-[14vh]">
  <h2 class="max-w-3xl text-[clamp(2.5rem,7vw,6rem)] leading-none font-bold tracking-[-0.04em]">
    Good design means <em class="font-serif font-normal">less</em> of this.
  </h2>

  <div data-popups class="relative mt-14 min-h-[580px] md:min-h-[420px]">
    <!-- Notification -->
    <div
      class="absolute top-0 right-0 w-[min(100%,360px)] rounded-2xl bg-paper p-4 opacity-0 shadow-2xl ring-1 ring-black/5 data-in:animate-pop"
      style="animation-delay:0s"
    >
      <p class="text-sm text-neutral-500">yoursite.com wants to</p>
      <p class="mt-1 font-medium">Show notifications</p>
      <div class="mt-4 flex justify-end gap-2">
        <button data-dismiss class="rounded-full px-4 py-2 text-sm font-medium ring-1 ring-ink">Block</button>
        <button data-dismiss class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-paper">Allow</button>
      </div>
    </div>

    <!-- Newsletter -->
    <div
      class="absolute top-40 left-0 w-[min(100%,420px)] rounded-3xl bg-ink p-7 text-paper opacity-0 shadow-2xl data-in:animate-pop md:top-10"
      style="animation-delay:0.25s"
    >
      <p class="font-serif text-4xl italic">Wait! Don't go…</p>
      <p class="mt-2 text-stone">Join 0 other people who get our weekly email.</p>
      <div class="mt-5 flex gap-2">
        <span class="flex-1 rounded-full bg-white/10 px-4 py-3 text-sm text-stone">you@email.com</span>
        <button data-dismiss class="rounded-full bg-accent px-5 py-3 text-sm font-medium">Subscribe</button>
      </div>
      <button data-dismiss class="mt-4 text-xs text-stone underline">No thanks, I hate good things</button>
    </div>

    <!-- Cookies -->
    <div
      class="absolute right-0 bottom-0 left-0 mx-auto flex w-[min(100%,640px)] flex-col gap-4 rounded-2xl bg-stone p-5 opacity-0 shadow-2xl data-in:animate-pop sm:flex-row sm:items-center"
      style="animation-delay:0.5s"
    >
      <p class="flex-1 text-sm">🍪 We use cookies to make this banner appear. By existing, you agree.</p>
      <div class="flex gap-2">
        <button data-dismiss class="rounded-full px-4 py-2 text-sm font-medium ring-1 ring-ink">Settings</button>
        <button data-dismiss class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-paper">Accept all</button>
      </div>
    </div>
  </div>
  <p class="mt-8 text-sm text-neutral-500">(Go on, click them away.)</p>
</section>

<script>
  const stack = document.querySelector('[data-popups]')!;
  new IntersectionObserver(([e], observer) => {
    if (!e.isIntersecting) return;
    observer.disconnect();
    stack.querySelectorAll(':scope > div').forEach((el) => el.setAttribute('data-in', ''));
  }, { threshold: 0.3 }).observe(stack);

  stack.querySelectorAll<HTMLElement>('[data-dismiss]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const card = btn.closest<HTMLElement>('[data-popups] > div')!;
      card.style.transition = 'opacity .3s, transform .3s';
      card.style.opacity = '0';
      card.style.transform = 'scale(.9)';
      card.style.pointerEvents = 'none';
    }),
  );
</script>
