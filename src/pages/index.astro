---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Skills from '../components/skills/Skills.astro';
import Next from '../components/Next.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Copy from '../components/Copy.astro';
import Cv from '../components/Cv.astro';
import Footer from '../components/Footer.astro';
import { site, breaks } from '../data/site';
---

<Layout title={site.title} description={site.description}>
  <main class="flex flex-col items-center">
    <Header />
    <Intro />
    <Skills />
    <Next />
    <CaseStudy />
    <section class="relative mx-auto flex max-w-[1800px] flex-col items-center justify-center py-[10vh]">
      <Copy paragraphs={breaks.pitch} tight />
    </section>
    <Cv />
    <section class="relative mx-auto flex max-w-[1800px] flex-col items-center justify-center pt-[10vh]">
      <Copy paragraphs={breaks.outro} tight />
    </section>
    <Footer />
  </main>
</Layout>
